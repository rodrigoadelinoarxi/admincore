<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Shared Tax Totals Templates for both Invoice and Sale Order Reports -->

    <!-- Substituir label subtotal no tax totals - handles both account.move and sale.order -->
    <template id="shared_document_tax_totals_template_inherit"
              inherit_id="account.document_tax_totals_template"
              priority="500">
        <xpath expr='//td/strong[contains(@t-out, "subtotal")]' position="replace">
            <strong t-if="(o and o._name == 'account.move' and o.company_id.use_custom_report) or (doc and doc._name == 'sale.order' and doc.company_id.use_custom_report)">
                Untaxed Amount
            </strong>
            <strong t-else="" t-out="subtotal['name']"/>
        </xpath>
    </template>

