#. module: casperventures
#: model:mail.template,body_html:casperventures.mail_template_daily_company_position
msgid ""
"<div>\n"
"                <h1>Daily Position\n"
"                    <t t-out=\"datetime.date.today().strftime('%d/%m/%Y')\" data-oe-t-"
"inline=\"true\">01/12/2023</t>\n"
"                </h1>\n"
"                <br>\n"
"                <h2><span>Sum of Availabilities</span>:\n"
"                </h2>\n"
"                <div style=\"font-weight: bold; font-size: 15px;\">\n"
"                    Total:\n"
"                    <t t-out=\"object.get_sum_availabilities_total_to_eur()\" t-options=\"{'widget': "
"'float', 'precision': 2}\"></t>\n"
"                    €\n"
"                </div>\n"
"\n"
"                <t t-foreach=\"object.get_sum_availabilities_of_current_balances().values()\" t-"
"as=\"sum_data\">\n"
"                    <div style=\"margin-bottom: -3px; font-size: 15px;\">\n"
"\n"
"                        <t t-out=\"sum_data['sum']\" t-options=\"{'widget': 'float', 'precision': 2}\"></"
"t>\n"
"                        <t t-out=\"sum_data['symbol']\"></t>\n"
"\n"
"                    </div>\n"
"                </t>\n"
"                <br>\n"
"                <h3><span>Bank Account Details</span>:\n"
"                </h3>\n"
"                <t t-foreach=\"object.get_bank_journal_data()\" t-as=\"journal_ids\">\n"
"                    <hr style=\"border-top: 1px solid black;\">\n"
"                    <t t-set=\"multiple_journals\" t-value=\"len(journal_ids) &gt; 1\"></t>\n"
"\n"
"                    <t t-if=\"not multiple_journals\">\n"
"                        <h3 t-att-style=\"'color:' + journal_ids[0].color_journal\">\n"
"                            <t t-out=\"journal_ids[0].name\">Revolut2</t>\n"
"                        </h3>\n"
"                    </t>\n"
"\n"
"                    <t t-if=\"not multiple_journals\">\n"
"                        <span>Account Balance</span>:\n"
"                        <span>\n"
"                            <t t-"
"out=\"journal_ids[0].get_journal_dashboard_datas().get('account_balance', 0)\">\n"
"                                100$\n"
"                            </t>\n"
"                        </span>\n"
"                        <br>\n"
"                        <br>\n"
"                    </t>\n"
"\n"
"                    <t t-foreach=\"journal_ids\" t-as=\"journal_id\">\n"
"                        <t t-set=\"journal_data\" t-value=\"journal_id.get_journal_dashboard_datas()\"></"
"t>\n"
"                        <t t-set=\"has_at_least_one_statement\" t-"
"value=\"journal_data.get('has_at_least_one_statement')\"></t>\n"
"\n"
"                        <h3 t-if=\"multiple_journals\" t-att-style=\"'color:' + "
"journal_id.color_journal\">\n"
"                            <t t-out=\"journal_id.name\">Revolut EUR</t>\n"
"                        </h3>\n"
"\n"
"                        <p t-if=\"multiple_journals\">\n"
"                            <span>Account Balance</span>:\n"
"                            <span>\n"
"                                <t t-out=\"journal_data.get('account_balance', 0)\">\n"
"                                    100$\n"
"                                </t>\n"
"                            </span>\n"
"                        </p>\n"
"\n"
"                        <t t-set=\"move_data\" t-value=\"journal_id.get_today_move_data()\"></t>\n"
"\n"
"                        <table class=\"table table-striped\" t-if=\"move_data\">\n"
"                            <thead>\n"
"                                <tr>\n"
"                                    <th>Date</th>\n"
"                                    <th>Description</th>\n"
"                                    <!--<th>Partner</th>-->\n"
"                                    <th class=\"text-right\">Value</th>\n"
"                                </tr>\n"
"                            </thead>\n"
"\n"
"                            <tbody>\n"
"                                <tr t-foreach=\"move_data\" t-as=\"move_data_id\">\n"
"                                    <td>\n"
"                                        <t t-out=\"move_data_id.get('date')\">01/12/2023</t>\n"
"                                    </td>\n"
"                                    <td>\n"
"                                        <t t-out=\"move_data_id.get('description')\">Referance Example</"
"t>\n"
"                                    </td>\n"
"                                    <td class=\"text-right\">\n"
"                                        <t t-out=\"move_data_id.get('amount')\" t-options=\"{'widget': "
"'monetary', 'display_currency': move_data_id.get('currency_id')}\">\n"
"                                            100$\n"
"                                        </t>\n"
"                                    </td>\n"
"                                </tr>\n"
"                            </tbody>\n"
"                        </table>\n"
"\n"
"                        <br>\n"
"                    </t>\n"
"                </t>\n"
"\n"
"                <br>\n"
"\n"
"            </div>\n"
"        "
