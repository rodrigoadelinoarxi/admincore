<odoo>
    <record id="project_project_view_form_simplified_inherit" model="ir.ui.view">
        <field name="name">project.project.view.form.simplified.inherit</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="hr_timesheet.project_project_view_form_simplified_inherit_timesheet"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='allow_timesheets']" position="after">
                <field name="company_id" invisible="1"/>
                <field name="analytic_group_id" invisible="not allow_timesheets" required="allow_timesheets"/>
            </xpath>
        </field>
    </record>

    <record id="project_project_form_view_inherited" model="ir.ui.view">
        <field name="name">project.project.view.inherited</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.project_project_view_form_simplified"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <group>
                    <group>
                        <field name="analytic_group_id" required="allow_timesheets"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
