<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.casperventures</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="91"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='employees_setting_container']//parent::div" position="inside">
                <h2>Employees Contract Alerts</h2>
                <div class="row mt16 o_settings_container" id="end_hr_contract_setting">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">End Date Contract Alert</span>
                            <div class="text-muted content-group mt16">
                                <span>Send an alert</span>
                                <field name="delay_alert_hr_contract" class="text-center oe_inline"/>
                                <span>days before the end date</span>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>

            <xpath expr="//field[@name='delay_alert_contract']/following-sibling::span" position="replace">
                <span>days before the contract or service check-up end date.</span>
            </xpath>

            <xpath expr="//block[@id='end_contract_setting']" position="after">
                <div class="row mt16 o_settings_container" id="end_contract_setting">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">Service Alert</span>
                            <div class="text-muted content-group mt16">
                                <span>Send an alert when there's less than</span>
                                <field name="fleet_km_between_services" class="text-center oe_inline"/>
                                <span>kilometers to the next car service.</span>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
    <record id="view_company_form_inherit_custom_report" model="ir.ui.view">
        <field name="name">res.company.form.inherit.custom.report</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Report Settings" name="custom_report_settings">
                    <group>
                        <field name="use_custom_report"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
