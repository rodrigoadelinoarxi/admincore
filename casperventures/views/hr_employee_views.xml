<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="view_employee_form_inherited_casper" model="ir.ui.view">
        <field name="name">hr.employee.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='active_group']/field[@name='user_id']" position="replace">
                <field name="user_id" string="Related User" domain="[]"/>
            </xpath>
            <xpath expr="//field[@name='ssnid']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>