<odoo>
    <record id="fleet_vehicle_view_form" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.casperventures</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='manager_id']" position="before">
                <label for="service_mileage_interval" invisible="vehicle_type != 'car'"/>
                <div class="o_row" invisible="vehicle_type != 'car'">
                    <field name="service_mileage_interval"/>
                    <field name="odometer_unit"/>
                </div>
                <field name="insurance" readonly="1"/>
            </xpath>

            <xpath expr="//field[@name='manager_id']" position="attributes">
                <attribute name="required">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
