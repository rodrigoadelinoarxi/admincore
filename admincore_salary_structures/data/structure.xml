<odoo>
    <data noupdate="0">

        <record id="structure_type_employee_lu" model="hr.payroll.structure.type">
            <field name="name">Employee LU</field>
            <field name="country_id" ref="base.pt"/>
            <field name="wage_type">monthly</field>
            <field name="default_schedule_pay">monthly</field>
            <field name="default_resource_calendar_id" ref="resource.resource_calendar_std"/>
<!--            <field name="default_struct_id" ref="hr_payroll_structure_empregado_L"/>-->
            <field name="default_work_entry_type_id" ref="hr_work_entry.work_entry_type_attendance"/>
        </record>


        <record id="structure_type_employee_moe" model="hr.payroll.structure.type">
            <field name="name">Employee MOE</field>
            <field name="country_id" ref="base.pt"/>
            <field name="wage_type">monthly</field>
            <field name="default_schedule_pay">monthly</field>
            <field name="default_resource_calendar_id" ref="resource.resource_calendar_std"/>
<!--            <field name="default_struct_id" ref="hr_payroll_structure_empregado_moe"/>-->
            <field name="default_work_entry_type_id" ref="hr_work_entry.work_entry_type_attendance"/>
        </record>
        <!--STRUCTURE-->
        <record id="hr_payroll_structure_empregado_L" model="hr.payroll.structure">
            <field name="name">Base Calculation for PT Salaries.L</field>
            <field name="type_id" ref="structure_type_employee_lu"/>
            <field name="use_worked_day_lines">True</field>
            <field name="country_id" ref="base.pt"/>
            <!--         <field name="report_id" ref="hr_payroll.action_report_payslip"/>-->
            <field name="schedule_pay">monthly</field>
            <field name="payslip_name">Salary Slip</field>
            <field name="rule_ids" eval="[]"/>
            <field name="unpaid_work_entry_type_ids" eval="[
            (4, ref('hr_work_entry_contract.work_entry_type_sick_leave')),
            (4, ref('l10n_pt_hr_payroll.maternity_leave_days_entry_type')),
            (4, ref('l10n_pt_hr_payroll.paternity_leave_days_entry_type')),
            (4, ref('l10n_pt_hr_payroll.marriage_leave_entry_type')),
            (4, ref('l10n_pt_hr_payroll.parental_leave_days_entry_type')),
            (4, ref('l10n_pt_hr_payroll.unjustified_absence_entry_type')),
        ]"/>
        </record>

        <record id="hr_payroll_structure_empregado_moe" model="hr.payroll.structure">
            <field name="name">Base Calculation for PT Salaries MOE</field>
            <field name="type_id" ref="structure_type_employee_moe"/>
            <field name="use_worked_day_lines">True</field>
            <field name="country_id" ref="base.pt"/>
            <!--         <field name="report_id" ref="hr_payroll.action_report_payslip"/>-->
            <field name="schedule_pay">monthly</field>
            <field name="payslip_name">Salary Slip</field>
            <field name="rule_ids" eval="[]"/>
            <field name="unpaid_work_entry_type_ids" eval="[
            (4, ref('hr_work_entry_contract.work_entry_type_sick_leave')),
            (4, ref('l10n_pt_hr_payroll.maternity_leave_days_entry_type')),
            (4, ref('l10n_pt_hr_payroll.paternity_leave_days_entry_type')),
            (4, ref('l10n_pt_hr_payroll.marriage_leave_entry_type')),
            (4, ref('l10n_pt_hr_payroll.parental_leave_days_entry_type')),
            (4, ref('l10n_pt_hr_payroll.unjustified_absence_entry_type')),
        ]"/>
        </record>
    </data>
</odoo>