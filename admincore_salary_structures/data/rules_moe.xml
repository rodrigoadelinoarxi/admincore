<odoo noupdate="1">
    <!--    SALARIO BASE-->
    <record id="hr_payroll_rules_base_moe" model="hr.salary.rule">
        <field name="category_id" ref="hr_payroll.BASIC"/>
        <field name="name">Basic Salary MOE</field>
        <field name="code">BASIC</field>
        <field name="sequence">1</field>
        <field name="struct_id" ref="admincore_salary_structures.hr_payroll_structure_empregado_moe"/>
        <field name="active">True</field>
        <field name="appears_on_payslip">True</field>
        <field name="income_type">A</field>
        <field name="ss_code">P</field>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
# Available variables:
#----------------------
# payslip: object containing the payslips
# employee: hr.employee object
# contract: hr.contract object
# rules: object containing the rules code (previously computed)
# categories: object containing the computed salary rule categories (sum of amount of all rules belonging to that category).
# worked_days: object containing the computed worked days.
# inputs: object containing the computed inputs.

# Note: returned value have to be set in the variable 'result'
#usamos a palavra work para identificar o trabalho que é pago
entries_work = entries_considered_work(payslip)
if any(not e.is_correction and e.code in entries_work for e in payslip.worked_days_line_ids):
    if not check_days_worked(payslip, employee, payslip.date_from.month, payslip.date_from.year):
        days = (payslip.date_to + relativedelta(days=1) - payslip.date_from).days
        result = (contract.wage / 30) * days
    else:
        result = contract.wage
    entries_discount = entries_to_discount_wage(payslip)
    if worked_days and payslip.worked_days_line_ids:
        for x in payslip.worked_days_line_ids:
            if x.code in entries_discount and not x.is_correction:   ## identificar aqui os work types a serem excluidos, função que devolve entries que descontam
                result -= (contract.wage / 30) * round(x.number_of_days)
    if result &lt; 0:
        result = 0
else:
    result = 0
if payslip.payslip_type == 'extraordinary':
    normal_slip_amount = get_previous_amount(payslip, 'BASIC')
    total = result - normal_slip_amount
    result = total if total >= 0 else 0
        </field>
        <field name="in_insurance_map">True</field>
        <field name="insurance_code">P</field>
    </record>

    <!--ISENÇÃO DE HORÁRIO-->
    <record id="hr_payroll_rules_ih_moe" model="hr.salary.rule">
        <field name="category_id" ref="hr_payroll.BASIC"/>
        <field name="name">Exemption schedule MOE</field>
        <field name="code">IH</field>
        <field name="sequence">2</field>
        <field name="appears_on_payslip">False</field>
        <field name="struct_id" ref="admincore_salary_structures.hr_payroll_structure_empregado_moe"/>
        <field name="condition_select">python</field>
        <field name="condition_python">result = contract.exemption_schedule</field>
        <field name="appears_on_payslip" eval="True"/>
        <field name="income_type">A</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
## Nos termos do artigo 272.º do Código do Trabalho, o valor da retribuição horária é calculado segundo a seguinte fórmula:
## (RMx12):(52xn) em que Rm é o valor da retribuição mensal e n o período normal de trabalho semanal.
## Assim, num exemplo de um trabalhador que receba uma retribuição mensal de € 1.000,00 com um período normal de trabalho de 40 horas de trabalho semanal, o cálculo seria:
## (1000×12):(52×40) = retribuição horária de € 5,76.
## Depois, teremos de atender ao previsto no artigo 268.º, n.º 1, alínea a) do Código do Trabalho, nos termos do qual o trabalho suplementar é pago pelo valor da retribuição horária com um acréscimo de 25% na primeira hora ou fracção desta."""

result = BASIC

result_rate = 25
if payslip.payslip_type == 'extraordinary':
    normal_slip_amount = get_previous_amount(payslip, 'IH')
    total = result - normal_slip_amount
    result = total if total >= 0 else 0

        </field>
        <field name="appears_on_payslip" eval="True"/>
        <field name="ss_code">M</field>
        <field name="in_insurance_map">True</field>
        <field name="insurance_code">M</field>
    </record>

    <!--    HORAS EXTRAS-->
    <record id="hr_payroll_rules_he_moe" model="hr.salary.rule">
        <field name="category_id" ref="l10n_pt_hr_payroll.hr_payroll_bonus_subject_to_irs"/>
        <field name="name">Extra hours MOE</field>
        <field name="code">HE</field>
        <field name="sequence">3</field>
        <field name="struct_id" ref="admincore_salary_structures.hr_payroll_structure_empregado_moe"/>
        <field name="active">True</field>
        <field name="condition_select">python</field>
        <field name="condition_python">result = _get_extra_hours_entries(payslip, employee)</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
# 50% na primeira hora ou fração, em dia útil;
# 75% na hora ou fração seguinte, em dia útil;
# 100% por cada hora ou fração em dia de descanso semanal (obrigatório ou complementar) ou feriado.
result_qty = 0
result = 0
if worked_days:
    total = 0
    total_extra_hours = 0
    work_entries = _get_extra_hours_entries(payslip, employee)
    if work_entries:
        for entry in work_entries:
            total_extra_hours += entry.duration
            total += calc_hours(contract,entry.duration, entry.date_start)
        result_qty = total_extra_hours
        result = total/total_extra_hours
        </field>
        <field name="appears_on_payslip" eval="True"/>
        <field name="income_type">A</field>
        <field name="ss_code">S</field>
        <field name="in_insurance_map">True</field>
        <field name="insurance_code">S</field>
    </record>

