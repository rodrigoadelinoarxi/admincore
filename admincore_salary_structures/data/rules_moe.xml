            <field name="amount_select">code</field>
            <field name="amount_python_compute">
result = contract.fail_allow_amount
entries_discount = entries_to_discount_wage(payslip)
if worked_days and payslip.worked_days_line_ids:
    for x in payslip.worked_days_line_ids:
        if x.code not in ['WORK100', 'HOLIDAY'] and not x.is_correction:   ## identificar aqui os work types a serem excluidos, função que devolve entries que descontam
            allocation = employee.company_id.default_vacation_days
            result -= (contract.fail_allow_amount / allocation) * round(x.number_of_days)
if payslip.payslip_type == 'extraordinary':
    normal_slip_amount = get_previous_amount(payslip, 'FAIL_ALLOW')
    total = result - normal_slip_amount
    result = total if total >= 0 else 0
result = result if result >= 0 else 0
            </field>
