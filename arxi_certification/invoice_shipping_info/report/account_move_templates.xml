<?xml version="1.0" encoding="utf-8"?>
<odoo><template id="report_invoice_document" inherit_id="account.report_invoice_document" priority="100"><xpath expr="//div[hasclass('page')]" position="inside"><!--tax point date--><div t-if="o.move_type == 'out_invoice' and o.tax_point_date and o.company_id.country_id.code == 'PT'" class="small" name="goods_available"><t t-set="o_tz" t-value="o.with_context(tz='Europe/Lisbon') if o.company_id.country_id.code == 'PT' else o"/><span>
                    Goods and/or services sent or made available to the purchaser at
                    <span t-field="o_tz.tax_point_date"/>
                    (art. 36th, n. 5, paragraph f of CIVA).
                </span></div><!--Shipping fields--><div t-if="o.show_shipping_info" name="expedition" class="row"><div class="col-4" t-if="o.gross_weight" name="gross_weight"><strong>Gross Weight:&amp;nbsp;</strong><span t-field="o.gross_weight"/><span t-field="o.weight_uom"/></div><div class="col-4" t-if="o.net_weight" name="net_weight"><strong>Net Weight:&amp;nbsp;</strong><span t-field="o.net_weight"/><span t-field="o.weight_uom"/></div><div class="col-4" t-if="o.number_of_parcels" name="number_of_parcels"><strong>Number of Parcels:&amp;nbsp;</strong><span t-field="o.number_of_parcels"/></div></div></xpath><xpath expr="//div[hasclass('oe_structure')]/parent::div" position="inside"><t t-if="o_tz and o.is_proof_delivery"><div style="page-break-inside: avoid;"><br/><strong>Shipping Departure Date:</strong><span t-field="o_tz.shipping_departure_date"/><br/></div></t></xpath></template></odoo>
