<?xml version="1.0" encoding="utf-8"?>
<odoo><template id="report_saleorder_document_tweaks" inherit_id="sale.report_saleorder_document" priority="100"><xpath expr="//div[hasclass('page')]" position="inside"><t t-call="l10n_pt_ao.report_staging_warning" t-lang="lang"/></xpath><xpath expr="//td[@name='td_name']/span" position="replace"><span t-out="line._get_report_name()" t-options="{'widget': 'text'}"/></xpath><xpath expr="//span[@t-field='doc.note']" position="attributes"><attribute name="t-if">not is_html_empty(doc.note) and not doc.needs_separate_comment_report</attribute></xpath><!--Remove optional products section--><xpath expr="//t[@t-set='has_option_discount']/parent::div" position="replace"/><xpath expr="//div[hasclass('page')]" position="after"><t t-if="doc.sale_order_option_ids and doc.state in ['draft', 'sent']"><t t-call="l10n_pt_ao_sale.report_option_products" t-lang="lang"/></t><t t-if="not is_html_empty(doc.note) and doc.needs_separate_comment_report"><t t-call="l10n_pt_ao_sale.report_terms_and_conditions" t-lang="lang"/></t></xpath></template><template id="report_terms_and_conditions"><t t-set="doc" t-value="doc.with_context(lang=lang)"/><div class="page" style="page-break-before: always;"><p class="fake_h3 mb-0">Terms &amp; Conditions</p><hr class="mt-0 mb-1"/><span name="comment" t-field="doc.note"/></div></template><template id="report_option_products"><t t-set="doc" t-value="doc.with_context(lang=lang)"/><div class="page" style="page-break-before: always;"><t t-set="has_option_discount" t-value="any(doc.sale_order_option_ids.filtered('discount'))"/><p class="fake_h3" name="h_optional_products"><span>Optional Products</span></p><table class="table table-sm"><thead><tr><th class="text-left">Description</th><th t-if="has_option_discount" groups="product.group_discount_per_so_line" class="text-left">Disc.%</th><th class="text-right">Unit Price</th></tr></thead><tbody class="sale_tbody"><tr t-foreach="doc.sale_order_option_ids" t-as="option"><td name="td_option_name"><span t-field="option.name"/></td><td t-if="has_option_discount" name="td_option_discount" groups="product.group_discount_per_so_line"><strong t-if="option.discount != 0.0" class="text-info"><t t-esc="((option.discount % 1) and '%s' or '%d') % option.discount"/>% discount
                            </strong></td><td name="td_option_price_unit"><strong class="text-right"><div t-field="option.price_unit" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.pricelist_id.currency_id}" t-att-style="option.discount and 'text-decoration: line-through' or None" t-att-class="option.discount and 'text-danger' or None"/><div t-if="option.discount"><t t-esc="'%.2f' % ((1-option.discount / 100.0) * option.price_unit)"/></div></strong></td></tr></tbody></table></div></template></odoo>
