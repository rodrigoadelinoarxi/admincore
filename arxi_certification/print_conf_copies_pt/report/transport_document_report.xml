<?xml version="1.0"?>
<odoo><template id="report_transport" inherit_id="l10n_pt_stock.report_transport"><xpath expr="//t[@t-call='web.html_container']" position="replace"><t t-call="web.html_container"><t t-foreach="docs" t-as="doc"><t t-set="copies" t-value="int(doc.print_copies)"/><t t-foreach="range(1, copies + 1)" t-as="print_type"><t t-set="lang" t-value="doc.partner_id.lang"/><t t-call="l10n_pt_stock.report_transport_document" t-lang="lang">
                        </t></t></t></t></xpath></template><template id="report_transport_document" inherit_id="l10n_pt_stock.report_transport_document" priority="10"><xpath expr="//h2" position="after"><!-- Import copies text display to template--><span class="text-nowrap" t-if="print_type == 1"><t t-if="not doc.doc_printed">Original</t><t t-else="">Copy of the document</t></span><span class="text-nowrap" t-if="print_type == 2"><t t-if="not doc.doc_printed">Duplicate</t><t t-else="">Copy of the document - Duplicate</t></span><span class="text-nowrap" t-if="print_type == 3"><t t-if="not doc.doc_printed">Triplicate</t><t t-else="">Copy of the document - Triplicate</t></span><span class="text-nowrap" t-if="print_type == 4"><t t-if="not doc.doc_printed">Quadruplicate</t><t t-else="">Copy of the document - Quadruplicate</t></span></xpath></template></odoo>
