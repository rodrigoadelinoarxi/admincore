<?xml version="1.0" encoding="utf-8"?>
<odoo><template id="report_invoice_document" inherit_id="account.report_invoice_document" primary="True" priority="200"><!--Get a l10n_pt formatted vat with an invalidated field if empty--><xpath expr="//div[@name='address_same_as_shipping']//t[@id='inv_tax_id_label']/parent::div" position="replace"><div><t t-if="o.company_id.account_fiscal_country_id.vat_label" t-esc="o.company_id.account_fiscal_country_id.vat_label" id="inv_tax_id_label"/><t t-else="">Tax ID</t>:
                <t t-if="o.state == 'draft'"><span t-out="o.partner_id.vat"/></t><t t-else=""><span t-out="o.document_address_id.get_l10n_pt_vat_repr()"/></t></div></xpath><xpath expr="//div[@name='address_not_same_as_shipping']//t[@id='inv_tax_id_label']/parent::div" position="replace"><div><t t-if="o.company_id.account_fiscal_country_id.vat_label" t-esc="o.company_id.account_fiscal_country_id.vat_label" id="inv_tax_id_label"/><t t-else="">Tax ID</t>:
                <t t-if="o.state == 'draft'"><span t-out="o.partner_id.vat"/></t><t t-else=""><span t-out="o.document_address_id.get_l10n_pt_vat_repr()"/></t></div></xpath><xpath expr="//div[@name='no_shipping']//t[@id='inv_tax_id_label']/parent::div" position="replace"><div><t t-if="o.company_id.account_fiscal_country_id.vat_label" t-esc="o.company_id.account_fiscal_country_id.vat_label" id="inv_tax_id_label"/><t t-else="">Tax ID</t>:
                <t t-if="o.state == 'draft'"><span t-out="o.partner_id.vat"/></t><t t-else=""><span t-out="o.document_address_id.get_l10n_pt_vat_repr()"/></t></div></xpath><!--Use the address at the post date of the document--><xpath expr="//div[@name='address_not_same_as_shipping']//address" position="attributes"><attribute name="t-field"/><attribute name="t-out">o.document_address_id or o.partner_id</attribute></xpath><xpath expr="//div[@name='address_same_as_shipping']//address" position="attributes"><attribute name="t-field"/><attribute name="t-out">o.document_address_id or o.partner_id</attribute></xpath><xpath expr="//div[@name='no_shipping']//address" position="attributes"><attribute name="t-field"/><attribute name="t-out">o.document_address_id or o.partner_id</attribute></xpath><!--h2 tag for the first print and a p for the remaining prints (to avoid multiple printing assert errors)--><xpath expr="//h2" position="replace"><h2 t-if="print_type == 1" t-att-style="'color: %s;' % o.company_id.primary_color"><span t-if="o.move_type == 'out_invoice' or o.is_self_billing" t-field="o.document_type_id.name" t-att-style="'color: %s ;' % o.company_id.primary_color"/> 
                <span t-elif="o.move_type == 'out_refund'" t-att-style="'color: %s ;' % o.company_id.primary_color">Credit Note</span> 
                <span t-elif="o.move_type == 'in_refund'" t-att-style="'color: %s ;' % o.company_id.primary_color">Vendor Credit Note</span> 
                <span t-elif="o.move_type == 'in_invoice'" t-att-style="'color: %s ;' % o.company_id.primary_color">Vendor Bill</span> 
                <span t-if="o.name != '/'" t-field="o.name" t-att-style="'color: %s ;' % o.company_id.primary_color"/> 
            </h2><p class="fake_h2" t-else="" t-att-style="'color: %s;' % o.company_id.primary_color"><span t-if="o.move_type == 'out_invoice' or o.is_self_billing" t-field="o.document_type_id.name"/> 
                <span t-elif="o.move_type == 'out_refund'">Credit Note</span> 
                <span t-elif="o.move_type == 'in_refund'">Vendor Credit Note</span> 
                <span t-elif="o.move_type == 'in_invoice'">Vendor Bill</span> 
                <span t-if="o.name != '/'" t-field="o.name"/> 
            </p></xpath><!--Depending on the invoice type (credit note or invoice) change label date--><xpath expr="//div[@name='invoice_date']" position="replace"><div class="col-auto col-3 mw-100 mb-2" t-if="o.invoice_date" name="invoice_date"><t t-if="o.move_type in ['out_refund', 'in_refund']"><strong>Credit Note Date:</strong></t><t t-else=""><strong>Invoice Date:</strong></t><p class="m-0" t-field="o.invoice_date"/></div></xpath><!--Self-Invoicing--><xpath expr="//div[@id='informations']" position="inside"><div class="col-auto col-3 mw-100 mb-2" t-if="o.is_self_billing" name="self_billing"><strong>Document Type:</strong><p class="m-0">Self-Billing</p></div></xpath><xpath expr="//div[@name='reference']" position="attributes"><attribute name="t-if">o.ref and not o.is_self_billing</attribute></xpath><xpath expr="//div[@name='reference']//span" position="attributes"><attribute name="t-out">o.ref</attribute></xpath><!--For self paid invoices, the due date is not needed--><xpath expr="//div[@name='due_date']" position="attributes"><attribute name="t-if">o.invoice_date_due and not o.is_self_paid</attribute></xpath><xpath expr="//table[@name='invoice_line_table']" position="replace"/><!--Move table inside a page element--><xpath expr="//t[@t-set='display_discount']" position="after"><t t-set="current_transport" t-value="0"/><t t-set="current_subtotal" t-value="0"/><t t-set="current_section" t-value="0"/><t t-set="line_doc_index" t-value="0"/><t t-set="pagebreak_before_subtotal" t-value="False"/><t t-set="original_lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/><t t-foreach="o.lines_layouted()" t-as="page"><!--Cancelled invoices require a specific mention in the document and can't be in the document name--><t t-if="o.state == 'cancel'"><p class="diagonal-text cancelled">Cancelled</p></t><!--Only show this div in the case of the last page not having lines/product table as the carried amout is in the table header--><div name="transported" t-if="not page" class="mb-0 mt-0 pb-0 pt-0"><strong>Carried:</strong><span t-out="current_transport" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/></div><!--If not in the first page, show the carried values outside the table--><div t-if="page and not page_first" class="is-subtotal text-start"><span class="mr16" style="font-weight: bold; display: inline-block; margin-top: 32px; margin-bottom: 8px;">Carried:</span><span t-out="current_transport" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/></div><table class="table table-sm o_main_table" name="invoice_line_table"><thead t-if="page"><tr><th name="th_description" class="text-start"><span>Description</span></th><th name="th_quantity" class="text-end"><span>Quantity</span></th><th name="th_priceunit" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>
                                    Unit Price
                                </span></th><th name="th_price_unit" t-if="display_discount" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>Disc.%</span></th><th name="th_taxes" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>
                                    Taxes
                                </span></th><th name="th_subtotal" class="text-end"><span groups="l10n_pt_ao.group_show_line_subtotals_tax_excluded">Amount</span><span groups="l10n_pt_ao.group_show_line_subtotals_tax_included">Total Price</span></th></tr></thead><tbody class="invoice_tbody"><t t-foreach="page" t-as="line"><t t-if="not line.id"><t t-if="pagebreak_before_subtotal"><tr class="is-subtotal text-end"><td colspan="99"><strong class="mr16">Subtotal</strong><span t-out="current_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/><t t-set="current_subtotal" t-value="0"/></td></tr></t><t t-set="pagebreak_before_subtotal" t-value="False"/></t><t t-else=""><t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="l10n_pt_ao.group_show_line_subtotals_tax_excluded"/><t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="l10n_pt_ao.group_show_line_subtotals_tax_included"/><t t-set="current_transport" t-value="current_transport + line.price_subtotal" groups="l10n_pt_ao.group_show_line_subtotals_tax_excluded"/><t t-set="current_transport" t-value="current_transport + line.price_total" groups="l10n_pt_ao.group_show_line_subtotals_tax_included"/><tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''"><t t-if="line.display_type == 'product'" name="account_invoice_line_accountable"><td name="account_invoice_line_name"><span t-out="'[%s] %s' % (line.product_id.default_code, line.name)" t-options="{'widget': 'text'}"/></td><td class="text-end"><span t-field="line.quantity"/> 
                                            <span t-field="line.product_uom_id" groups="uom.group_uom"/>
                                        </td><td t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span class="text-nowrap" t-field="line.price_unit"/></td><td t-if="display_discount" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span class="text-nowrap" t-field="line.discount"/></td><td t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span t-out="', '.join(map(lambda x: (x.invoice_label or x.description or x.name), line.tax_ids))" id="line_tax_ids"/></td><td class="text-end o_price_total"><span class="text-nowrap" t-field="line.price_subtotal" groups="l10n_pt_ao.group_show_line_subtotals_tax_excluded"/><span class="text-nowrap" t-field="line.price_total" groups="l10n_pt_ao.group_show_line_subtotals_tax_included"/></td></t><t t-if="line.display_type == 'line_section'"><td colspan="99"><span t-field="line.name" t-options="{'widget': 'text'}"/></td><t t-set="current_section" t-value="line"/></t><t t-if="line.display_type == 'line_note'"><td colspan="99"><span t-field="line.name" t-options="{'widget': 'text'}" class="fst-italic text-secondary"/></td></t></tr><t t-if="current_section and (line == original_lines[-1] or original_lines[line_doc_index+1].display_type == 'line_section')"><t t-set="pagebreak_before_subtotal" t-value="line_last and not page_last"/><tr class="is-subtotal text-end" t-if="not pagebreak_before_subtotal">
                                    </tr></t><t t-set="line_doc_index" t-value="line_doc_index + 1"/></t></t></tbody><tfoot t-if="not page_last" class="mb-0 mt-0 pb-0 pt-0"><tr class="is-subtotal text-end"><td name="td_section_carrying" colspan="99"><strong class="mr16">Carrying:</strong><span t-out="current_transport" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/></td></tr></tfoot></table><p t-if="not page_last" style="page-break-before:always;"/></t></xpath><!--Total section with float right to be able to add a column to its left--><xpath expr="//div[@id='total']" position="attributes"><attribute name="class" remove="clearfix" separator=" "/></xpath><xpath expr="//div[@id='total']/div" position="attributes"><attribute name="class" add="float-right" separator=" "/><attribute name="class" remove="ms-auto" separator=" "/></xpath><xpath expr="//div[@id='right-elements']" position="before">

        </xpath><xpath expr="//div[hasclass('clearfix')]" position="attributes"><attribute name="class">clearfix mb-0</attribute></xpath><xpath expr="//div[@id='total']/parent::div" position="after"><div name="subtotal_left" t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-5 col-md-6'}"><table class="table table-sm" style="page-break-inside: avoid;" t-if="o.company_currency_id != o.currency_id"><t t-call="account.document_tax_totals"><t t-set="tax_totals" t-value="o.tax_totals_company"/></t></table><br/><strong t-if="o.line_ids.mapped('tax_ids').filtered('exemption_id')">Exemption Codes</strong><p t-foreach="o.line_ids.mapped('tax_ids.exemption_id')" t-as="exemption" class="mb-0"><strong><span t-field="exemption.code"/>:
                    </strong><span class="m-0" t-field="exemption.name"/></p></div><span class="small" t-if="o.company_currency_id != o.currency_id">Exchange rate:
                <t t-esc="o.rate_string"/>
            </span></xpath><!--Remove margins--><xpath expr="//p[@name='payment_communication']" position="attributes"><attribute name="class"/><attribute name="t-if">not o.is_self_paid</attribute></xpath><xpath expr="//div[@id='informations']" position="attributes"><attribute name="class">row</attribute></xpath><xpath expr="//div[hasclass('oe_structure')]/parent::div" position="attributes"><attribute name="class">mt-0</attribute></xpath><xpath expr="//div[@id='qrcode']" position="replace"><t t-if="o.qr_code_position == 'bottom'"><t t-set="visible_row_div" t-value="(o.inalterable_hash and o.is_sale_document() and o.company_id.qr_code_pt) or o.has_mb_reference()"/><div name="atcud_qr_code" style="page-break-inside: avoid; padding-top: 25px;"><span t-if="o.inalterable_hash and o.is_sale_document()" class="small">ATCUD:
                        <t t-out="o.atcud or '0'"/>
                    </span><div id="row_div" t-if="visible_row_div" class="d-flex flex-row"><div id="qrcode_pt" name="qrcode_pt_bottom" t-if="o.inalterable_hash and o.is_sale_document() and o.company_id.qr_code_pt" style="height: 150px; width: 150px" class="border border-dark rounded"><img t-att-src="image_data_uri(o.build_qr_code())" style="height: 100%; width: 100%;"/></div><!-- hash characters: 1st, 11th, 21st, 31st, 41st--></div><span t-if="o.inalterable_hash" class="small"><span t-translation="off" class="small text-nowrap" t-out="''.join([o.inalterable_hash[i] for i in range(0,40,10)])"/>- Processed by
                        certified
                        software no. 2790/AT
                    </span></div></t></xpath><xpath expr="//t[@t-if='o.partner_shipping_id and (o.partner_shipping_id != o.partner_id)']/parent::div" position="after"><t t-if="o.qr_code_position == 'top'"><t t-if="o.partner_shipping_id and (o.partner_shipping_id != o.partner_id) and env.user.has_group('account.group_delivery_invoice_address')"><div class="row" style="margin:20px 0px 50px 0px;"><div class="col-6"><t t-set="visible_row_div" t-value="(o.inalterable_hash and o.is_sale_document() and o.company_id.qr_code_pt) or o.has_mb_reference()"/><span t-if="o.inalterable_hash and o.is_sale_document()" class="small">ATCUD:
                                <t t-out="o.atcud or '0'"/>
                            </span><div id="row_div" t-if="visible_row_div" class="d-flex flex-row"><div id="qrcode_pt" name="qrcode_pt_top_with_shipping" t-if="o.inalterable_hash and o.is_sale_document() and o.company_id.qr_code_pt" style="height: 150px; width: 150px" class="border border-dark rounded"><img t-att-src="image_data_uri(o.build_qr_code())" style="height: 100%; width: 100%;"/></div></div><!-- hash characters: 1st, 11th, 21st, 31st, 41st--><span t-if="o.inalterable_hash" class="small"><span t-translation="off" class="small text-nowrap" t-out="''.join([o.inalterable_hash[i] for i in range(0,40,10)])"/>- Processed by
                                certified
                                software no. 2790/AT
                            </span></div></div></t><t t-else=""><div class="row" style="margin:-80px 0px 50px 0px;"><div class="col-6"><t t-set="visible_row_div" t-value="(o.inalterable_hash and o.is_sale_document() and o.company_id.qr_code_pt) or o.has_mb_reference()"/><span t-if="o.inalterable_hash and o.is_sale_document()" class="small">ATCUD:
                                <t t-out="o.atcud or '0'"/>
                            </span><div id="row_div" t-if="visible_row_div" class="d-flex flex-row"><div id="qrcode_pt" name="qrcode_pt_top_without_shipping" t-if="o.inalterable_hash and o.is_sale_document() and o.company_id.qr_code_pt" style="height: 150px; width: 150px" class="border border-dark rounded"><img t-att-src="image_data_uri(o.build_qr_code())" style="height: 100%; width: 100%;"/></div></div><!-- hash characters: 1st, 11th, 21st, 31st, 41st--><span t-if="o.inalterable_hash" class="small"><span t-translation="off" class="small text-nowrap" t-out="''.join([o.inalterable_hash[i] for i in range(0,40,10)])"/>- Processed by
                                certified
                                software no. 2790/AT
                            </span></div></div></t></t></xpath><xpath expr="//t[@t-call='account.document_tax_totals_company_currency_template']" position="replace"/></template><template id="report_invoice_document_mock" inherit_id="l10n_pt_certificate.report_invoice_document" primary="True" priority="999"><xpath expr="//table[@name='invoice_line_table']/thead" position="inside"><tr name="mock_header_spacer" t-if="not page_first"><th colspan="99" style="padding:0; border:none; height: 16px;"/></tr></xpath><xpath expr="//t[@t-foreach='o.lines_layouted()']" position="attributes"><attribute name="t-foreach">[o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name,
                -l.id), reverse=True)]</attribute></xpath><xpath expr="//t[@name='account_invoice_line_accountable']/parent::tr" position="attributes"><attribute name="t-att-line-id">line.id</attribute></xpath><!-- Easier to find by id--><xpath expr="//td[@name='account_invoice_line_name']/span" position="replace"><span t-out="line.get_mock_report_line_name()" t-options="{'widget': 'text'}"/></xpath><xpath expr="//t[@name='account_invoice_line_accountable']/following-sibling::t/td/span" position="replace"><span t-out="line.get_mock_report_line_name()" t-options="{'widget': 'text'}"/></xpath><xpath expr="//t[@name='account_invoice_line_accountable']/following-sibling::t/following-sibling::t/td/span" position="replace"><span t-out="line.get_mock_report_line_name()" t-options="{'widget': 'text'}"/></xpath><xpath expr="//div[@name='transported']" position="attributes"><attribute name="t-if">True</attribute></xpath><xpath expr="//tfoot[@t-if='not page_last']" position="attributes"><attribute name="t-if">True</attribute></xpath><!--        <xpath expr="//strong[@name='main_subtotal_string']" position="replace">--><!--            <strong name="main_subtotal_string" class="mr16">{+0+}</strong>--><!--        </xpath>--></template><template id="report_invoice_mock"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-set="lang" t-value="o.invoice_user_id.sudo().lang if o.is_purchase_document() else o.partner_id.lang"/><t t-set="copies" t-value="report_type != 'html' and o.journal_id.l10n_cert and int(o.print_copies) or 1"/><t t-foreach="range(1, copies + 1)" t-as="i"><t t-call="l10n_pt_certificate.report_invoice_document_mock" t-lang="lang"><t t-set="print_type" t-value="i"/></t></t></t></t></template><record id="account_invoices_mock" model="ir.actions.report"><field name="name">Invoices Mock</field><field name="model">account.move</field><field name="report_type">qweb-pdf</field><field name="report_name">l10n_pt_certificate.report_invoice_mock</field><field name="report_file">l10n_pt_certificate.report_invoice_mock</field><field name="print_report_name">(object._get_report_base_filename())</field><field name="attachment"/></record></odoo>
