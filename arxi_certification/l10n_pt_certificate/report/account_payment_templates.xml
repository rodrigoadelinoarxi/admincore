<?xml version="1.0" encoding="utf-8"?>
<odoo><template id="report_payment_inherit" inherit_id="account.report_payment_receipt_document"><xpath expr="//div[hasclass('page')]" position="inside"><t t-if="o.qr_code_position == 'bottom'"><div name="atcud_qr_code" style="page-break-inside: avoid; padding-top: 20px;"><span t-if="o.move_id.inalterable_hash and o.partner_type == 'customer'" class="small">ATCUD:
                        <t t-out="o.atcud or '0'"/>
                    </span><div id="row_div" class="d-flex flex-row"><div id="qrcode_pt" name="qrcode_pt_payment_bottom" t-if="o.move_id.inalterable_hash and o.payment_name and o.company_id.qr_code_pt" style="height: 150px; width: 150px" class="border border-dark rounded"><img t-att-src="image_data_uri(o.move_id.build_qr_code())" style="height: 100%; width: 100%;"/></div></div><t t-if="o.company_id.country_id.code == 'PT' and o.move_id.inalterable_hash and o.partner_type == 'customer'"><!-- hash characters: 1st, 11th, 21st, 31st, 41st--><span t-if="o.move_id.inalterable_hash" class="small"><span t-translation="off" class="small text-nowrap" t-out="''.join([o.move_id.inalterable_hash[i] for i in range(0,40,10)])"/>- Processed
                            by
                            certified
                            software no. 2790/AT
                        </span></t></div></t></xpath><xpath expr="//div[hasclass('page')]" position="before"><t t-if="o.qr_code_position == 'top'"><div name="qr_code_div_top" class="col-6 qr_code_div_top" style="margin-top:-80px;"><span t-if="o.move_id.inalterable_hash and o.partner_type == 'customer'" class="small">ATCUD:
                        <t t-out="o.atcud or '0'"/>
                    </span><div id="row_div" class="d-flex flex-row"><div id="qrcode_pt" name="qrcode_pt_payment_top" t-if="o.move_id.inalterable_hash and o.payment_name and o.company_id.qr_code_pt" style="height: 150px; width: 150px" class="border border-dark rounded"><img t-att-src="image_data_uri(o.move_id.build_qr_code())" style="height: 100%; width: 100%;"/></div></div><t t-if="o.company_id.country_id.code == 'PT' and o.move_id.inalterable_hash and o.partner_type == 'customer'"><!-- hash characters: 1st, 11th, 21st, 31st, 41st--><span t-if="o.move_id.inalterable_hash" class="small"><span t-translation="off" class="small text-nowrap" t-out="''.join([o.move_id.inalterable_hash[i] for i in range(0,40,10)])"/>- Processed
                            by
                            certified
                            software no. 2790/AT
                        </span></t></div></t></xpath><xpath expr="//div[hasclass('page')]" position="attributes"><attribute name="t-att-style">'margin-top:30px;' if o.qr_code_position == 'top' else 'margin-top:0px;'
            </attribute></xpath><xpath expr="//h3" position="attributes"><attribute name="t-att-style">'margin-top:0px;' if o.partner_id.street else 'margin-top:70px;'</attribute></xpath><xpath expr="//div[@id='total']/div" position="inside"><span class="small" t-if="o.company_currency_id != o.currency_id">
                Exchange rate:
                <t t-esc="o.rate_string"/>
            </span></xpath></template></odoo>
