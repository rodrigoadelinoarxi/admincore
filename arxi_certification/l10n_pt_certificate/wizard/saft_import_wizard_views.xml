<?xml version="1.0" encoding="utf-8"?>
<odoo><record id="saft_import_wizard_view_form" model="ir.ui.view"><field name="name">saft.import.wizard.view.form</field><field name="model">saft.import.wizard</field><field name="arch" type="xml"><form string="SAF-T Import"><field name="state" invisible="True"/><sheet><group invisible="state != 'choose'"><field name="data"/><group><field name="force_encoding"/><field name="encoding" invisible="not force_encoding" required="force_encoding"/></group><group><field name="country_code" invisible="True"/><field name="tax_accounting_basis"/><field name="invoicing_legacy" invisible="tax_accounting_basis != 'F'"/></group><group string="Import Journals" invisible="tax_accounting_basis == 'C'"><field name="company_id" invisible="True"/><field name="journal_id" string="Invoice Journal" options="{'no_create_edit': True}" required="tax_accounting_basis != 'C'"/><field name="payment_journal_id" options="{'no_create_edit': True}"/></group><group string="Which data to import?"><field name="is_import_customers"/><field name="search_by_ref"/><field name="is_import_suppliers"/><field name="is_import_products" invisible="tax_accounting_basis == 'C'"/><field name="is_import_documents" invisible="tax_accounting_basis == 'C'"/><field name="is_import_balance" invisible="tax_accounting_basis == 'F'"/><field name="is_import_accounts" invisible="tax_accounting_basis == 'F'"/><field name="is_import_moves" invisible="tax_accounting_basis == 'F'"/><field name="document_batch_size"/></group></group><group invisible="state != 'get'"><field name="result" readonly="True"/></group><h3 invisible="state not in ['confirm', 'confirm_batch']">Records to Import</h3><notebook invisible="state not in ['confirm', 'confirm_batch']"><page string="Customers" name="customers"><field name="customer_ids" nolabel="1"><tree create="0" delete="0" no_open="1"><field name="partner_id" invisible="True"/><field name="name"/><field name="vat"/><field name="ref"/><field name="record_to_import" widget="boolean_toggle" readonly="parent.state == 'confirm_batch'"/></tree></field></page><page string="Suppliers" name="suppliers"><field name="supplier_ids" nolabel="1"><tree create="0" delete="0" no_open="1"><field name="partner_id" invisible="True"/><field name="name"/><field name="vat"/><field name="ref"/><field name="record_to_import" widget="boolean_toggle" readonly="parent.state == 'confirm_batch'"/></tree></field></page><page string="Products" name="products" invisible="tax_accounting_basis == 'C'"><field name="product_ids" nolabel="1"><tree create="0" delete="0" no_open="1"><field name="name"/><field name="type"/><field name="default_code"/><field name="categ_id"/><field name="record_to_import" widget="boolean_toggle"/></tree></field></page><page string="Invoices" name="invoices" invisible="tax_accounting_basis == 'C'"><field name="invoice_ids" nolabel="1"><tree create="0" delete="0" no_open="1" editable="top"><field name="name" readonly="True"/><field name="type" readonly="True"/><field name="partner_id" readonly="True"/><field name="currency_id" invisible="True"/><field name="amount_total" readonly="True"/><field name="amount_paid" readonly="import_status != 'open'"/><field name="import_status" readonly="parent.invoicing_legacy"/></tree></field></page><page string="Accounts" name="accounts" invisible="tax_accounting_basis == 'F'"><field name="account_ids" nolabel="1"><tree create="0" delete="0" no_open="1" decoration-success="is_update_or_create == False"><field name="is_update_or_create" invisible="True"/><field name="name"/><field name="code"/><field name="taxonomy_code"/><field name="group_categ" optional="hide"/><field name="record_to_import" widget="boolean_toggle" readonly="parent.is_import_moves or not is_update_or_create"/></tree></field></page><page string="Journals" name="journals" invisible="tax_accounting_basis == 'F'"><field name="journal_ids" nolabel="1"><tree create="0" delete="0" no_open="1" editable="bottom"><field name="journal_id" invisible="True"/><field name="name" readonly="journal_id != False"/><field name="code" readonly="journal_id != False"/><field name="import_moves" readonly="journal_id" widget="boolean_toggle"/></tree></field></page><page string="Moves" name="moves" invisible="tax_accounting_basis == 'F'"><field name="move_ids" nolabel="1"><tree create="0" delete="0" no_open="1"><field name="name"/><field name="wizard_journal_id"/><field name="record_to_import" widget="boolean_toggle"/></tree></field></page></notebook></sheet><footer><button name="load_from_file" string="Next" type="object" invisible="state != 'choose'" class="oe_highlight"/><button name="prev" string="Previous" type="object" invisible="state != 'confirm'"/><button name="execute" string="Import" type="object" invisible="state not in ['confirm', 'confirm_batch']" class="oe_highlight"/><button name="refresh_wizard" string="Refresh" type="object" invisible="state not in ['confirm', 'confirm_batch']" class="oe_highlight"/><button special="cancel" string="Close" class="oe_highlight"/></footer></form></field></record></odoo>
