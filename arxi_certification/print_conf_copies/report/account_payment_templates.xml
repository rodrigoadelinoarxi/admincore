<?xml version="1.0"?>
<odoo><template id="report_payment_receipt" inherit_id="account.report_payment_receipt" priority="10"><!-- Remove base t-call to template to be replaced by the foreach statement--><xpath expr="//t[@t-call='account.report_payment_receipt_document']" position="replace"><!-- add comment template and duplicates--><t t-set="copies" t-value="int(o.print_copies)"/><t t-foreach="range(1, copies + 1)" t-as="print_type"><t t-call="account.report_payment_receipt_document" t-lang="lang"/></t></xpath></template><template id="report_payment_receipt_document" inherit_id="account.report_payment_receipt_document" priority="10"><xpath expr="//div[@t-if='o.date']/../.." position="before"><!-- Import copies text display to template--><t t-call="print_conf_copies.print_copies_display" t-lang="lang"/></xpath></template></odoo>
