<?xml version="1.0"?>
<odoo><template id="print_copies_report_invoice" inherit_id="account.report_invoice" priority="10"><!-- Remove base t-call to template to be replaced by the foreach statement--><xpath expr="//t[@t-call='account.report_invoice_document']" position="replace"><!-- add comment template and duplicates--><t t-set="copies" t-value="report_type != 'html' and o.journal_id.l10n_cert and int(o.print_copies) or 1"/><t t-foreach="range(1, copies + 1)" t-as="i"><t t-if="o._get_name_invoice_report() == 'account.report_invoice_document'" t-call="account.report_invoice_document" t-lang="o.partner_id.lang"><t t-set="print_type" t-value="i"/></t></t></xpath></template><template id="print_copies_report_invoice_document" inherit_id="account.report_invoice_document" priority="10"><xpath expr="//h2" position="before"><!-- Import copies text display to template--><t t-call="print_conf_copies.print_copies_display" t-lang="lang"/></xpath></template></odoo>
