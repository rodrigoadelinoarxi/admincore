<?xml version="1.0"?>
<odoo><record id="invoice_form_inherit_l10n_pt_edi" model="ir.ui.view"><field name="name">l10n.pt.edi.invoice.form</field><field name="model">account.move</field><field name="inherit_id" ref="account.view_move_form"/><field name="arch" type="xml"><xpath expr="//field[@name='edi_document_ids']" position="attributes"><attribute name="readonly">True</attribute><attribute name="options">{}</attribute></xpath><xpath expr="//field[@name='edi_document_ids']//button[@name='action_export_xml']" position="attributes"><attribute name="invisible">not error or state == 'to_send'</attribute></xpath><xpath expr="//field[@name='external_sequence']" position="after"><field name="edi_external_sequence" groups="base.group_no_one"/><field name="cius_pt_id" groups="base.group_no_one"/></xpath></field></record><record id="action_account_download_xml_files" model="ir.actions.server"><field name="name">Download xml Files</field><field name="model_id" ref="account.model_account_move"/><field name="binding_model_id" ref="account.model_account_move"/><field name="binding_view_types">list</field><field name="state">code</field><field name="code">
