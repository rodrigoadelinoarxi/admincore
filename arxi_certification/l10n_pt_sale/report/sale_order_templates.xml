<?xml version="1.0" encoding="utf-8"?>
<odoo><template id="qr_code_container_sale_order"><div name="qr_code_container"><t t-set="visible_row_div" t-value="(doc.pt_arxi_inalterable_hash and doc.company_id.qr_code_pt) or doc.has_mb_reference()"/><div class="col-6 mt-3" style="page-break-inside: avoid; margin-top: 20px;"><p t-if="doc.pt_arxi_inalterable_hash and doc.company_id.qr_code_pt" class="mb-0 mt-0 small">ATCUD:
                    <t t-out="doc.pt_arxi_atcud or '0'"/>
                </p><div id="row_div" t-if="visible_row_div" class="d-flex flex-row"><div id="qrcode_pt" name="qrcode_pt_sale_top" t-if="doc.pt_arxi_inalterable_hash and doc.company_id.qr_code_pt" style="height: 150px; width: 150px" class="border border-dark rounded"><img t-att-src="image_data_uri(doc.build_qr_code())" style="height: 100%; width: 100%;"/></div></div><!-- hash characters: 1st, 11th, 21st, 31st, 41st--><span t-if="doc.pt_arxi_inalterable_hash" class="small"><span t-translation="off" class="small text-nowrap" t-out="''.join([doc.pt_arxi_inalterable_hash[i] for i in range(0,40,10)])"/>- Processed by certified
                    software ndoc. 2790/AT
                </span></div></div></template><template id="report_saleorder_document" inherit_id="sale.report_saleorder_document" priority="200" primary="True"><!--Replace partner addresses for static document addresses--><xpath expr="//t[@t-set='address']/div" position="attributes"><attribute name="t-field"/><attribute name="t-out">doc.sale_journal.l10n_pt_cert and (doc.document_address_id or doc.partner_id) or
                doc.partner_id
            </attribute></xpath><xpath expr="//div[@t-field='doc.partner_invoice_id']" position="attributes"><attribute name="t-field"/><attribute name="t-out">doc.sale_journal.l10n_pt_cert and (doc.document_invoice_address_id or
                doc.partner_invoice_id) or doc.partner_invoice_id
            </attribute></xpath><xpath expr="//div[@t-field='doc.partner_shipping_id']" position="attributes"><attribute name="t-field"/><attribute name="t-out">doc.sale_journal.l10n_pt_cert and (doc.document_shipping_address_id or
                doc.partner_shipping_id) or doc.partner_shipping_id
            </attribute></xpath><!--Invalidate VAT Label field if it wasn't provided--><xpath expr="//p[@t-if='doc.partner_id.vat']" position="replace"><p name="vat_for_address"><t t-esc="doc.company_id.account_fiscal_country_id.vat_label or 'Tax ID'"/>:
                <span t-out="doc.sale_journal.l10n_pt_cert and doc.document_address_id.get_l10n_pt_ao_vat_repr() or doc.partner_id.vat"/></p></xpath><xpath expr="//div[@id='informations']//div[@name='informations_date']" position="replace"><div t-if="doc.date_order" class="col-auto col-3 mw-100 mb-2" name="informations_date"><strong>Emission Date:</strong><p class="m-0" t-field="doc.date_order" t-options="{&quot;widget&quot;: &quot;date&quot;}"/></div></xpath><xpath expr="//table[hasclass('o_main_table')]" position="replace"><t t-set="current_transport" t-value="0"/><t t-set="current_subtotal" t-value="0"/><t t-set="current_section" t-value="0"/><t t-set="line_doc_index" t-value="0"/><t t-set="pagebreak_before_subtotal" t-value="False"/><t t-set="original_lines" t-value="doc.order_line.filtered(lambda l: not l.is_downpayment).sorted(key=lambda l: (-l.sequence, l.order_id.date_order, l.order_id.name, -l.id), reverse=True)"/><t t-foreach="doc.lines_layouted()" t-as="page"><!-- Cancelled Tag--><t t-if="doc.state == 'cancel'"><p class="diagonal-text cancelled">Cancelled</p></t><!--Only show this div in the case of the last page not having lines/product table as the carried amout is in the table header--><div name="transported" t-if="not page"><div class="mb-0 mt-0 pb-0 pt-0"><strong>Carried:</strong><span t-out="current_transport" style="font-weight: normal;" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}"/></div></div><!--If not in the first page, show the carried values outside the table--><div t-if="page and not page_first" class="is-subtotal text-start"><strong class="mr16" style="display: inline-block; margin-top: 32px; margin-bottom: 8px;">Carried:</strong><span t-out="current_transport" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}"/></div><table class="table table-sm o_main_table" style="font-family: monospace;"><thead t-if="page"><tr><th name="th_description" class="text-start">Description</th><th name="th_quantity" class="text-end">Quantity</th><th name="th_priceunit" class="text-end">Unit Price</th><th name="th_discount" t-if="display_discount" class="text-end" groups="sale.group_discount_per_so_line"><span>Disc.%</span></th><th name="th_taxes" class="text-end">Taxes</th><th name="th_subtotal" class="text-end"><span>Amount</span></th></tr></thead><tbody class="sale_tbody"><t t-foreach="page" t-as="line"><t t-if="not line.id"><t t-if="pagebreak_before_subtotal"><tr class="is-subtotal text-end"><td colspan="99"><strong class="mr16">Subtotal</strong><span t-out="current_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}"/><t t-set="current_subtotal" t-value="0"/></td></tr></t><t t-set="pagebreak_before_subtotal" t-value="False"/></t><t t-else=""><t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"/><t t-set="current_transport" t-value="current_transport + line.price_subtotal"/><tr t-att-line-id="line.id" t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''"><t t-if="not line.display_type"><td name="td_name"><span t-esc="line.name" t-options="{'widget': 'text'}"/></td><td name="td_quantity" class="text-end"><span t-field="line.product_uom_qty"/> <span t-field="line.product_uom" groups="uom.group_uom"/></td><td name="td_priceunit" class="text-end"><span t-field="line.price_unit"/></td><td t-if="display_discount" class="text-end" groups="sale.group_discount_per_so_line"><span t-field="line.discount"/></td><td name="td_taxes" class="text-end"><span t-out="', '.join(map(lambda x: (x.invoice_label or x.name), line.tax_ids))"/></td><td class="text-end o_price_total"><span class="text-nowrap" t-field="line.price_subtotal"/></td></t><t t-if="line.display_type == 'line_section'"><td name="td_section_line" colspan="99"><span t-field="line.name" t-options="{'widget': 'text'}"/></td><t t-set="current_section" t-value="line"/><t t-set="current_subtotal" t-value="0"/></t><t t-if="line.display_type == 'line_note'"><td name="td_note_line" colspan="99"><span t-field="line.name" t-options="{'widget': 'text'}" class="fst-italic"/></td></t></tr><t t-if="current_section and (line == original_lines[-1] or original_lines[line_doc_index+1].display_type == 'line_section')"><t t-set="pagebreak_before_subtotal" t-value="line_last and not page_last"/><tr class="is-subtotal text-end" t-if="not pagebreak_before_subtotal"><td name="td_section_subtotal" colspan="99"><strong name="main_subtotal_string" class="mr16">Subtotal</strong><span t-out="current_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}"/></td></tr></t><t t-set="line_doc_index" t-value="line_doc_index + 1"/></t></t></tbody><tfoot t-if="not page_last" class="mb-0 mt-0 pb-0 pt-0"><tr class="is-subtotal text-end"><td name="td_section_carrying" colspan="99"><strong class="mr16">Carrying:</strong><span t-out="current_transport" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}"/></td></tr></tfoot></table><p t-if="not page_last" style="page-break-before:always;"/></t></xpath><!--Add certification hash check and software number--><xpath expr="//p[@name='vat_for_address']" position="after"><t t-if="doc.partner_shipping_id == doc.partner_invoice_id and doc.partner_invoice_id != doc.partner_id or doc.partner_shipping_id != doc.partner_invoice_id"><t t-if="doc.qr_code_position == 'top'"><div class="mt-2"><t t-call="l10n_pt_sale.qr_code_container_sale_order"/></div></t></t></xpath><xpath expr="//div[hasclass('page')]" position="before"><t t-if="not(doc.partner_shipping_id == doc.partner_invoice_id and doc.partner_invoice_id != doc.partner_id or doc.partner_shipping_id != doc.partner_invoice_id)"><t t-if="doc.qr_code_position == 'top'"><t t-call="l10n_pt_sale.qr_code_container_sale_order"/></t></t></xpath><xpath expr="//div[hasclass('page')]" position="inside"><span name="not_invoice" class="small">This document is not an invoice.</span><t t-if="doc.qr_code_position == 'bottom'"><t t-call="l10n_pt_sale.qr_code_container_sale_order"/></t><span t-if="not doc.pt_arxi_inalterable_hash" class="font-weight-bold" style="font-weight:bold; font-size:16pt;"><br/><span>Document Not Certified</span></span></xpath><xpath expr="//div[@id='informations']" position="attributes"><attribute name="class">row mt-0 mb-0</attribute></xpath><xpath expr="//div[@id='total']" position="replace"><div id="total" class="row mt-n3 align-items-start" name="total"><t t-set="show_company_totals" t-value="doc.has_certified_journal and doc.company_currency_id != doc.currency_id"/><t t-set="totals_col_class" t-value="('col-6' if report_type != 'html' else 'col-sm-7 col-md-6') + ('' if show_company_totals else ' ms-auto')"/><t t-if="show_company_totals"><div name="subtotal_left" t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-5 col-md-6'} pe-3" style="margin-top: 32px;"><table class="o_total_table table table-borderless" style="page-break-inside: avoid;"><t t-call="sale.document_tax_totals"><t t-set="tax_totals" t-value="doc.tax_totals_company"/><t t-set="currency" t-value="doc.company_currency_id"/></t></table><t t-if="doc.rate_string"><span class="small">
                                Exchange Rate:
                                <t t-esc="doc.rate_string"/>
                            </span></t></div></t><div t-att-class="totals_col_class + ' ps-4'" style="margin-top: 32px;"><table class="o_total_table table table-borderless" style="page-break-inside: avoid;"><t t-call="sale.document_tax_totals"><t t-set="tax_totals" t-value="doc.tax_totals"/><t t-set="currency" t-value="doc.currency_id"/></t></table></div></div></xpath></template><template id="report_saleorder_document_mock" inherit_id="l10n_pt_sale.report_saleorder_document" primary="True" priority="999"><xpath expr="//t[@t-foreach='doc.lines_layouted()']" position="attributes"><attribute name="t-foreach">[doc.order_line.filtered(lambda l: not l.is_downpayment)]</attribute></xpath><!-- Easier to find by id--><xpath expr="//td[@name='td_name']/span" position="replace"><span class="line_id_mock" t-out="line.get_mock_report_line_name()" t-options="{'widget': 'text'}"/></xpath><xpath expr="//td[@name='td_section_line']/span" position="replace"><span class="line_id_mock" t-out="line.get_mock_report_line_name()" t-options="{'widget': 'text'}"/></xpath><xpath expr="//td[@name='td_note_line']/span" position="replace"><span class="line_id_mock" t-out="line.get_mock_report_line_name()" t-options="{'widget': 'text'}"/></xpath><xpath expr="//div[@name='transported']" position="attributes"><attribute name="t-if">True</attribute></xpath><xpath expr="//tfoot[@t-if='not page_last']" position="attributes"><attribute name="t-if">True</attribute></xpath><xpath expr="//strong[@name='main_subtotal_string']" position="replace"><strong name="main_subtotal_string" class="mr16">{+0+}</strong></xpath></template><template id="report_saleorder_mock"><t t-call="web.html_container"><t t-foreach="docs" t-as="doc"><t t-set="lang" t-value="doc.partner_id.lang"/><t t-set="copies" t-value="report_type != 'html' and doc.sale_journal.l10n_pt_cert and int(doc.print_copies) or 1"/><t t-foreach="range(1, copies + 1)" t-as="i"><t t-call="l10n_pt_sale.report_saleorder_document_mock" t-lang="lang"><t t-set="print_type" t-value="i"/></t></t></t></t></template><record id="action_report_saleorder_mock" model="ir.actions.report"><field name="name">Quotation / Order Mock</field><field name="model">sale.order</field><field name="report_type">qweb-pdf</field><field name="report_name">l10n_pt_sale.report_saleorder_mock</field><field name="report_file">l10n_pt_sale.report_saleorder_mock</field><field name="print_report_name">(object._get_report_base_filename())</field></record><template id="report_saleorder_pro_forma" inherit_id="sale.report_saleorder_pro_forma" priority="20"><xpath expr="//t[@t-call='sale.report_saleorder_document']" position="replace"><t t-if="doc.company_id.country_id.code == 'PT'"><t t-call="l10n_pt_sale.report_saleorder_document" t-lang="doc.partner_id.lang"/></t><t t-else=""><t t-call="sale.report_saleorder_document" t-lang="doc.partner_id.lang"/></t></xpath></template></odoo>
