#. module: l10n_pt_multicert
#: model:mail.template,body_html:l10n_pt_multicert.email_template_multicert_invoice
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                Dear\n"
"                <t t-if=\"object.partner_id.parent_id\">\n"
"                    <t t-out=\"object.partner_id.name or ''\"/>\n"
"                    (<t t-out=\"object.partner_id.parent_id.name or ''\"/>),\n"
"                </t>\n"
"                <t t-else=\"\">\n"
"                    <t t-out=\"object.partner_id.name or ''\"/>,\n"
"                </t>\n"
"                <br/>\n"
"                <br/>\n"
"                Here is your\n"
"                <t t-if=\"object.name\">\n"
"                    invoice\n"
"                    <strong t-out=\"object.name or ''\"/>\n"
"                </t>\n"
"                <t t-else=\"\">\n"
"                    invoice\n"
"                </t>\n"
"                <t t-if=\"object.invoice_origin\">\n"
"                    (with reference: <t t-out=\"object.invoice_origin or ''\"/>)\n"
"                </t>\n"
"                amounting in\n"
"                <strong t-out=\"format_amount(object.amount_total, object.currency_id) or ''\"/>\n"
"                from <t t-out=\"object.company_id.name or ''\"/>.\n"
"                <t t-if=\"object.payment_state in ('paid', 'in_payment')\">\n"
"                    This invoice is already paid.\n"
"                </t>\n"
"                <t t-else=\"\">\n"
"                    Please remit payment at your earliest convenience.\n"
"                    <t t-if=\"object.payment_reference\">\n"
"                        <br/>\n"
"                        <br/>\n"
"                        Please use the following communication for your payment: <strong t-out=\"object.payment_reference or ''\"/>.\n"
"                    </t>\n"
"                </t>\n"
"                <br/>\n"
"                <br/>\n"
"                Do not hesitate to contact us if you have any questions.\n"
"                <t t-if=\"object.invoice_user_id.signature\">\n"
"                    <br/>\n"
"                    <t t-out=\"object.invoice_user_id.signature or ''\"/>\n"
"                </t>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                Car@\n"
"                <t t-if=\"object.partner_id.parent_id\">\n"
"                    <t t-out=\"object.partner_id.name or ''\"/>\n"
"                    (<t t-out=\"object.partner_id.parent_id.name or ''\"/>),\n"
"                </t>\n"
"                <t t-else=\"\">\n"
"                    <t t-out=\"object.partner_id.name or ''\"/>,\n"
"                </t>\n"
"                <br/>\n"
"                <br/>\n"
"                Aqui está a sua\n"
"                <t t-if=\"object.name\">\n"
"                    fatura\n"
"                    <strong t-out=\"object.name or ''\"/>\n"
"                </t>\n"
"                <t t-else=\"\">\n"
"                    fatura\n"
"                </t>\n"
"                <t t-if=\"object.invoice_origin\">\n"
"                    (com referência: <t t-out=\"object.invoice_origin or ''\"/>)\n"
"                </t>\n"
"                com um total de\n"
"                <strong t-out=\"format_amount(object.amount_total, object.currency_id) or ''\"/>\n"
"                de <t t-out=\"object.company_id.name or ''\"/>.\n"
"                <t t-if=\"object.payment_state in ('paid', 'in_payment')\">\n"
"                    Esta fatura já se encontra paga.\n"
"                </t>\n"
"                <t t-else=\"\">\n"
"                    Por favor, envie o pagamento o mais cedo possível.\n"
"                    <t t-if=\"object.payment_reference\">\n"
"                        <br/>\n"
"                        <br/>\n"
"                        Por favor, use a seguinte referência para o seu pagamento: <strong t-out=\"object.payment_reference or ''\"/>.\n"
"                    </t>\n"
"                </t>\n"
"                <br/>\n"
"                <br/>\n"
"                Não hesite em nos contactar se tiver alguma dúvida.\n"
"                <t t-if=\"object.invoice_user_id.signature\">\n"
"                    <br/>\n"
"                    <t t-out=\"object.invoice_user_id.signature or ''\"/>\n"
"                </t>\n"
"            </div>\n"
"        "

