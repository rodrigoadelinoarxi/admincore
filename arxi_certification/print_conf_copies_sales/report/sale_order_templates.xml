<?xml version="1.0"?>
<odoo><template id="report_saleorder_raw" inherit_id="sale.report_saleorder_raw" priority="10"><xpath expr="//t[@t-call='sale.report_saleorder_document']" position="replace"><t t-set="copies" t-value="int(doc.print_copies)"/><t t-foreach="range(1, copies + 1)" t-as="print_type"><t t-call="sale.report_saleorder_document" t-lang="doc.partner_id.lang"/></t></xpath></template><template id="report_saleorder_pro_forma" inherit_id="sale.report_saleorder_pro_forma" priority="10"><xpath expr="//t[@t-call='sale.report_saleorder_document']" position="replace"><t t-set="copies" t-value="int(doc.print_copies)"/><t t-foreach="range(1, copies + 1)" t-as="print_type"><t t-if="doc.company_id.country_id.code == 'PT'"><t t-call="l10n_pt_sale.report_saleorder_document" t-lang="doc.partner_id.lang"/></t><t t-else=""><t t-call="sale.report_saleorder_document" t-lang="doc.partner_id.lang"/></t></t></xpath></template><template id="report_saleorder_document" inherit_id="sale.report_saleorder_document" priority="10"><xpath expr="//span[@t-field='doc.name']/.." position="after"><span class="text-nowrap" t-if="print_type == 1"><t t-if="not doc.doc_printed">Original</t><t t-else="">Copy of the document - Original</t></span><span class="text-nowrap" t-if="print_type == 2"><t t-if="not doc.doc_printed">Duplicate</t><t t-else="">Copy of the document - Duplicate</t></span><span class="text-nowrap" t-if="print_type == 3"><t t-if="not doc.doc_printed">Triplicate</t><t t-else="">Copy of the document - Triplicate</t></span><span class="text-nowrap" t-if="print_type == 4"><t t-if="not doc.doc_printed">Quadruplicate</t><t t-else="">Copy of the document - Quadruplicate</t></span></xpath></template></odoo>
