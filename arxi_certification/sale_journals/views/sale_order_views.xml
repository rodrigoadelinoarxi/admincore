<?xml version="1.0" encoding="utf-8"?>
<odoo><!--Form view--><record id="view_order_form" model="ir.ui.view"><field name="name">sale.order.form.inherit.l10n_pt_sale</field><field name="model">sale.order</field><field name="inherit_id" ref="sale.view_order_form"/><field name="arch" type="xml"><!--Sale order Name or 'Draft'--><xpath expr="//field[@name='name']" position="replace"><span invisible="state != 'draft' or name != '/'">Draft</span><field name="name" readonly="True" invisible="name == '/'"/></xpath><!--Create a new group with the invoicing group and the new other info group--><xpath expr="//group[@name='sale_info']" position="before"><group name="sale_info_main"/></xpath><xpath expr="//group[@name='sale_info_main']" position="inside"><xpath expr="//group[@name='sale_info']" position="move"/></xpath><xpath expr="//group[@name='sale_info']" position="attributes"><attribute name="class">mt-0</attribute><attribute name="colspan">2</attribute></xpath><!--Add journal and sale document type--><xpath expr="//group[@name='sale_info_main']" position="inside"><group name="other_info_sep" string="Other Info" colspan="2" class="mt-0"><field name="sale_journal" string="Sale Journal" required="True" options="{'no_create_edit': True}" readonly="state != 'draft'" domain="[('sale_type_id', '=', sale_type_id)]"/><field name="sale_type_id" readonly="True"/></group></xpath></field></record><!--Add domain to the existing quotation action--><record id="sale.action_quotations_with_onboarding" model="ir.actions.act_window"><field name="domain">[('sale_type_id.code', '=', 'OR')]</field></record><record id="action_view_proforma" model="ir.actions.server"><field name="name">Proforma Invoices</field><field name="model_id" ref="sale.model_sale_order"/><field name="binding_model_id" ref="sale.model_sale_order"/><field name="state">code</field><field name="code">
            action = model.action_view_proforma()
        </field></record><record id="action_other_docs" model="ir.actions.act_window"><field name="name">Other Type of Sales</field><field name="type">ir.actions.act_window</field><field name="res_model">sale.order</field><field name="view_mode">tree,kanban,form,calendar,pivot,graph,activity</field><field name="search_view_id" ref="sale.sale_order_view_search_inherit_quotation"/><field name="context">{'search_default_my_quotation': 1, 'default_sale_type': 'OU'}</field><field name="domain">[('sale_type_id.code', '=', 'OU')]</field><field name="help" type="html"><p class="o_view_nocontent_smiling_face">
                Create a new sale!
            </p></field></record></odoo>
