<?xml version="1.0" encoding="utf-8"?>
<odoo><template id="report_custom_invoice_document" inherit_id="account.report_invoice_document" priority="100"><xpath expr="//td[@name='account_invoice_line_name']/span" position="replace"><span t-out="'[%s] %s' % (line.product_id.default_code, line.name)" t-options="{'widget': 'text'}"/></xpath><xpath expr="//div[@name='comment']" position="attributes"><attribute name="t-if">not is_html_empty(o.narration) and not o.needs_separate_comment_report</attribute></xpath><xpath expr="//div[@name='comment']" position="replace"><t t-if="o.narration and not o.needs_separate_comment_report"><span name="comment" t-field="o.narration"/></t></xpath><xpath expr="//t[@t-set='information_block']" position="attributes"><attribute name="t-if">not o.is_proof_delivery</attribute></xpath><xpath expr="//div[hasclass('oe_structure')]/parent::div" position="inside"><br/><!--Loading address--><div class="row" t-if="o.is_proof_delivery" style="page-break-inside: avoid;"><div name="loading_address" t-out="loading_address" class="col-6"><strong>Loading Address:</strong><div class="d-flex align-items-baseline"><span class="w-100 o_force_ltr d-block" itemprop="streetAddress"><span t-out="o.loading_address_street"/><span t-out="o.loading_address_street2"/></span></div><div class="d-flex align-items-baseline"><span class="o_force_ltr"><div><span t-out="o.loading_address_city"/><span t-out="o.loading_address_state_id.code"/><span t-out="o.loading_address_zip"/></div></span></div><div class="d-flex align-items-baseline"><span class="o_force_ltr" t-out="o.loading_address_country_id.name"/></div></div><div name="shipping_address" t-if="o.document_shipping_address_id or o.document_commercial_address_id or o.partner_shipping_id" t-out="shipping_address" class="col-6"><div t-if="o.document_commercial_address_id or o.commercial_partner_id"><strong>Company address:</strong><div t-out="o.document_commercial_address_id or o.commercial_partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: True}"/></div><div t-if="o.document_shipping_address_id or o.partner_shipping_id" groups="account.group_delivery_invoice_address"><strong>Shipping address:</strong><div t-out="o.document_shipping_address_id or o.partner_shipping_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;], &quot;no_marker&quot;: True}"/></div></div></div></xpath><xpath expr="//div[@name='shipping_address_block']//div" position="attributes"><attribute name="t-field"/><attribute name="t-out">o.document_shipping_address_id or o.partner_shipping_id</attribute></xpath><xpath expr="//h2" position="after"><t t-call="l10n_pt_ao.report_staging_warning" t-lang="lang"/></xpath><xpath expr="//div[hasclass('page')]" position="after"><t t-if="not is_html_empty(o.narration) and o.needs_separate_comment_report"><t t-call="l10n_pt_ao.report_terms_and_conditions" t-lang="lang"/></t></xpath></template><template id="report_terms_and_conditions"><t t-set="o" t-value="o.with_context(lang=lang)"/><div class="page" style="page-break-before: always;"><p class="fake_h3 mb-0">Terms &amp; Conditions</p><hr class="mt-0 mb-1"/><span name="comment" t-field="o.narration"/></div></template><template id="report_invoice" inherit_id="account.report_invoice" priority="101"><!-- Remove base t-call to template to be replaced by the foreach statement--><xpath expr="//t[@t-call='account.report_invoice_document']" position="replace"><!-- add comment template and duplicates--><t t-if="o._get_name_invoice_report() == 'account.report_invoice_document'" t-call="account.report_invoice_document" t-lang="o.partner_id.lang">
            </t></xpath></template></odoo>
