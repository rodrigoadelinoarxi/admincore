<?xml version="1.0" encoding="utf-8"?>
<odoo><template id="external_layout_striped" inherit_id="web.external_layout_striped"><xpath expr="//div[@t-field='company.report_footer']/parent::ul/following-sibling::div" position="replace"><div t-if="report_type == 'pdf'" class="text-muted row"><div class="col-4"><span class="text-start" name="document_name" t-if="o and all(f in o._fields for f in ('company_id', 'inalterable_hash')) and o.company_id.country_code in ['PT', 'AO']" t-esc="o._get_report_base_filename()"/></div><div class="col-4">
                    Page:
                    <span class="page"/>
                    of
                    <span class="topage"/>
                </div></div></xpath></template><template id="external_layout_boxed" inherit_id="web.external_layout_boxed"><xpath expr="//div[@t-field='company.report_footer']/following-sibling::div" position="replace"><div t-if="report_type == 'pdf'" class="row"><div class="col-4"><span class="text-start" name="document_name" t-if="o and all(f in o._fields for f in ('company_id', 'inalterable_hash')) and o.company_id.country_code in ['PT', 'AO']" t-esc="o._get_report_base_filename()"/></div><div class="col-4">
                    Page: <span class="page"/> / <span class="topage"/>
                </div></div></xpath></template><template id="external_layout_bold" inherit_id="web.external_layout_bold"><xpath expr="//div[hasclass('h5')]" position="before"><p t-if="o and all(f in o._fields for f in ('company_id', 'inalterable_hash')) and o.company_id.country_code in ['PT', 'AO']" style="white-space: nowrap;" name="document_name" class="mt-0 mb-0" t-esc="o._get_report_base_filename()"/></xpath><xpath expr="//ul[hasclass('pagenumber')]/li" position="replace"><li class="list-inline-item"><strong style="white-space: nowrap;"><span class="page"/> of <span class="topage"/></strong></li></xpath></template><template id="external_layout_standard" inherit_id="web.external_layout_standard"><xpath expr="//div[@t-field='company.report_footer']/parent::ul/following-sibling::div" position="replace"><div class="text-muted row" t-if="report_type == 'pdf'"><div class="col-4"><span class="text-start" name="document_name" t-if="o and all(f in o._fields for f in ('company_id', 'inalterable_hash')) and o.company_id.country_id.code in ['PT', 'AO']" t-esc="o._get_report_base_filename()"/></div><div class="col-4"><span class="text-center">Page: <span class="page"/> / <span class="topage"/></span></div></div></xpath></template></odoo>
