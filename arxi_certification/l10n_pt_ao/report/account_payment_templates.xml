<?xml version="1.0" encoding="utf-8"?>
<odoo><template id="report_payment_inherit" inherit_id="account.report_payment_receipt_document"><!--Add static address--><xpath expr="//span[@t-field='o.partner_id']" position="replace"><span t-if="o.document_address_id" t-field="o.document_address_id"/><span t-else="" t-field="o.partner_id"/></xpath><!--Title depending on payment type--><xpath expr="//h3/strong" position="replace"><strong><h2><t t-if="o.payment_type == 'outbound'">Payment </t><t t-if="o.payment_type == 'inbound'">Receipt </t><t t-if="o.payment_type == 'transfer'">Transfer </t><span t-if="o.payment_name" t-field="o.payment_name"/> 
                    <span t-else="" t-field="o.name"/>
                </h2></strong></xpath><!--Disable old fields for partner and total amount--><xpath expr="//div[@t-if='o.partner_type']" position="replace"/><xpath expr="//div[@t-if='o.amount']" position="replace"/><!--Add partner address to the document--><xpath expr="//div[hasclass('page')]" position="before"><t t-set="address" t-if="not o.is_internal_transfer and o.document_commercial_address_id or o.document_address_id"><address class="mb-0" t-field="o.document_commercial_address_id or o.document_address_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: True}"/><div t-if="o.document_commercial_address_id.vat or o.document_address_id.vat"><t t-esc="o.company_id.country_id.vat_label or 'Tax ID'"/><span t-field="o.document_commercial_address_id.vat or o.document_address_id.vat"/></div></t><t t-set="address" t-elif="not o.is_internal_transfer and o.partner_id"><address class="mb-0" t-field="o.partner_id.commercial_partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: True}"/><div t-if="o.partner_id.commercial_partner_id.vat"><t t-esc="o.company_id.country_id.vat_label or 'Tax ID'"/>:
                    <span t-field="o.partner_id.commercial_partner_id.vat"/></div></t></xpath><!--Show transaction date--><xpath expr="//div[@t-if='o.date']" position="replace"><div class="col-6" t-if="o.date">
                Posting Date:
                <span t-field="o.posting_date"/>
            </div></xpath><xpath expr="//table[hasclass('table','table-sm')]" position="before"><t t-if="o.state == 'cancel'"><p class="diagonal-text cancelled">Cancelled</p></t><t t-call="l10n_pt_ao.report_staging_warning" t-lang="lang"/></xpath><xpath expr="//span[@t-field='o.payment_method_id.name']" position="replace"><span t-field="o.payment_method_line_id.name"/></xpath><!--Table with payment lines instead of invoices--><xpath expr="//table[hasclass('table','table-sm')]" position="attributes"><attribute name="t-if">o.payment_type == 'transfer'</attribute></xpath><xpath expr="//table[hasclass('table','table-sm')]" position="before"><table class="table table-sm" t-if="o.payment_type in ('inbound', 'outbound')"><thead><tr><th>Invoice Date</th><th>Invoice Number</th><th class="text-right">Original Amount</th><th class="text-right">Previous Receipt</th><th class="text-right">Amount Paid</th><th class="text-right">Balance</th></tr></thead><tbody><tr t-foreach="o.payment_line_ids" t-as="line"><td><t t-if="line.invoice_date"><span t-field="line.invoice_date"/></t><t t-elif="line.external_invoice_date"><span t-field="line.external_invoice_date"/></t></td><td><t t-if="line.invoice_id"><span t-field="line.invoice_id.name"/></t><t t-elif="line.external_invoice_name"><span t-field="line.external_invoice_name"/></t></td><td class="text-right"><span t-field="line.original_amount"/></td><td class="text-right"><span t-field="line.previous_payment"/></td><td class="text-right"><span t-field="line.amount"/></td><td class="text-right"><span t-field="line.balance"/></td></tr></tbody></table></xpath><!--Total section--><xpath expr="//table[hasclass('table','table-sm')][2]" position="after"><div class="clearfix"><div id="total" class="row"><div t-attf-class="#{'col-4' if report_type != 'html' else 'col-sm-7 col-md-5'} ml-auto"><table class="table table-sm"><t t-if="o.discount"><tr class="border-black o_subtotal" style=""><td><strong>Subtotal</strong></td><td class="text-right"><span t-field="o.amount_subtotal"/></td></tr><tr style=""><td><t t-if="o.discount &gt;= 0"><strong>Discount</strong></t><t t-else=""><strong>Advance</strong></t></td><td class="text-right o_price_total"><span t-esc="abs(o.discount)" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/></td></tr></t><tr class="border-black o_total" id="total_row"><td><strong>Total</strong></td><td class="text-right"><span t-field="o.amount"/></td></tr><t t-if="o.company_currency_id != o.currency_id"><tr class="border-black o_total"><td><strong>Total (<span t-field="o.company_currency_id.name"/>)
                                        </strong></td><td class="text-right"><span t-field="o.amount_company"/></td></tr></t></table></div></div></div></xpath><xpath expr="//div[hasclass('page')]" position="after"><p t-field="o.narration"/><p name="not_invoice">This document is not an invoice.</p></xpath></template></odoo>
