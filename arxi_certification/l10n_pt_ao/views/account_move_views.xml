ice', 'in_refund', 'in_receipt')</attribute><attribute name="readonly">parent.state != 'draft' and display_type not in ['line_section', 'line_note']</attribute></xpath><xpath expr="//field[@name='invoice_line_ids']/tree//field[@name='account_id']" position="attributes"><attribute name="readonly">parent.state != 'draft' and display_type not in ['line_section', 'line_note']</attribute></xpath><xpath expr="//field[@name='invoice_line_ids']/tree//field[@name='tax_ids']" position="attributes"><attribute name="readonly">parent.state != 'draft' and display_type not in ['line_section', 'line_note']</attribute></xpath><xpath expr="//field[@name='invoice_line_ids']/form//field[@name='product_id']" position="attributes"><attribute name="readonly">parent.is_rappel</attribute></xpath><xpath expr="//field[@name='invoice_line_ids']/form//field[@name='quantity']" position="attributes"><attribute name="readonly">parent.is_rappel</attribute></xpath><xpath expr="//field[@name='invoice_line_ids']/form//field[@name='price_unit']" position="attributes"><attribute name="readonly">parent.is_rappel</attribute></xpath><xpath expr="//field[@name='invoice_line_ids']/form//field[@name='discount']" position="attributes"><attribute name="readonly">parent.is_rappel</attribute></xpath><xpath expr="//field[@name='invoice_line_ids']/form//field[@name='name']" position="attributes"><attribute name="readonly">parent.state != 'draft' and display_type not in ['line_section', 'line_note']</attribute></xpath><xpath expr="//field[@name='invoice_line_ids']/form//field[@name='tax_ids']" position="attributes"><attribute name="readonly">parent.state != 'draft' and display_type not in ['line_section', 'line_note']</attribute></xpath><xpath expr="//field[@name='line_ids']//field[@name='name']" position="before"><field name="product_id" column_invisible="True"/></xpath><!--Supplier fields--><xpath expr="//field[@name='ref']" position="attributes"><attribute name="required">has_required_document_type and move_type 