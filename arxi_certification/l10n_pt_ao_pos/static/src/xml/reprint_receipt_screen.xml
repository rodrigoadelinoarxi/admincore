<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="l10n_pt_ao_pos.ReprintReceiptScreen" t-inherit="point_of_sale.ReprintReceiptScreen" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('print')]" position="after">
            <button class="button print btn btn-lg btn-secondary w-100 py-3 mt-1" t-on-click="printDuplicateReceipt">
                <i class="fa fa-print ms-2" t-ref="order-print-receipt-button_duplicate"/> Print Duplicate Receipt
            </button>
            <button class="button print btn btn-lg btn-secondary w-100 py-3 mt-1" t-on-click="printTriplicateReceipt">
                <i class="fa fa-print ms-2" t-ref="order-print-receipt-button_triplicate"/> Print Triplicate Receipt
            </button>
        </xpath>
    </t>

</templates>
