<?xml version="1.0" encoding="utf-8"?>
<odoo><template id="report_transport"><t t-call="web.html_container"><t t-foreach="docs" t-as="doc"><t t-foreach="int(doc.company_id.print_copies)" t-as="i"><t t-set="lang" t-value="doc.partner_id.lang"/><t t-call="l10n_pt_stock.report_transport_document" t-lang="lang"><t t-set="print_type" t-value="i"/></t></t></t></t></template><template id="report_transport_document"><t t-call="web.html_container"><t t-call="web.external_layout"><t t-set="doc" t-value="doc.with_context(lang=lang)"/><t name="partner_header"><t t-set="address"><t t-if="doc.document_address_id"><div t-field="doc.document_address_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True}"/></t><div t-if="doc.document_address_id.vat" class="mt16"><t t-out="doc.company_id.country_id.vat_label or 'Tax ID'"/>:
                            <span t-out="doc.document_address_id.get_l10n_pt_vat_repr()"/></div></t></t><t t-if="doc.qr_code_position == 'top'"><div style="margin-top:-80px;" class="qr_is_on_top_div col-6"><p t-if="doc.inalterable_hash and doc.company_id.qr_code_pt" class="mb-0 mt-0 small">ATCUD:
                            <t t-out="doc.atcud or '0'"/>
                        </p><div id="qrcode_pt" t-if="doc.inalterable_hash and doc.company_id.qr_code_pt"><img class="border border-dark rounded" width="150px" height="150px" t-att-src="image_data_uri(doc.build_qr_code())"/></div><p id="certificate_text" t-if="doc.inalterable_hash and doc.company_id.country_id.code == 'PT'"><span t-translation="off" class="text-nowrap" t-out="''.join([doc.inalterable_hash[i] for i in range(0,40,10)])"/>- Processed by
                            certified
                            software no. 2790/AT
                        </p></div></t><div class="page" style="margin:0px"><h2><span t-out="doc._get_report_base_filename()"/></h2><p t-if="doc.at_doc_code_id"><strong>
                            AT Code:
                            <span t-field="doc.at_doc_code_id"/>
                        </strong></p><br/><div style="padding-bottom: 150px;"><div style="float: left; width: 50%;"><span><h4>Loading Address</h4></span><t t-out="doc.loading_address_street"/><br/><t t-out="doc.loading_address_zip"/><t t-out="doc.loading_address_city"/><br/><t t-out="doc.loading_address_country.name"/></div><div style="float: right; width: 50%;" t-if="not doc.hide_delivery_address"><span><h4>Delivery Address</h4></span><t t-out="doc.delivery_address_street"/><br/><t t-out="doc.delivery_address_zip"/><t t-out="doc.delivery_address_city"/><br/><t t-out="doc.delivery_address_country.name"/></div></div><div id="informations" class="row mt32 mb32"><div name="date" t-if="doc.date" class="col-auto mw-100 mb-2"><strong>Posting Date</strong><p class="m-0" t-field="doc.date"/></div><div t-if="doc.movement_start_date" class="col-auto mw-100 mb-2"><strong>Estimated Start Date</strong><p class="m-0" t-field="doc.movement_start_date"/></div><div name="date_done" t-if="doc.movement_end_date" class="col-auto mw-100 mb-2"><strong>Estimated End Date</strong><p class="m-0" t-field="doc.movement_end_date" t-options="{'widget': 'date'}"/></div><div t-if="doc.vehicle_id" class="col-auto mw-100 mb-2"><strong>Vehicle License Plate</strong><p class="m-0" t-field="doc.vehicle_id"/></div></div><t t-if="doc.state == 'cancel'"><p class="diagonal-text cancelled">Cancelled</p></t><t t-call="l10n_pt_ao.report_staging_warning" t-lang="lang"/><table class="table table-sm mt48"><t t-set="has_serial_number" t-value="doc.transport_line_ids.mapped('lot_ids')" groups="stock.group_lot_on_delivery_slip"/><thead><tr><th><span>Product</span></th><t name="lot_serial" t-if="has_serial_number"><th>
                                        Lot/Serial Number
                                    </th></t><th class="text-center"><span>Quantity</span></th></tr></thead><tbody><tr t-foreach="doc.transport_line_ids" t-as="product_line"><td><span t-out="product_line.product_id._get_report_code()"/><span t-field="product_line.name"/></td><t t-if="has_serial_number" name="move_line_lot"><td><span t-out="', '.join(product_line.lot_ids.mapped('name'))"/></td></t><td class="text-center"><span t-out="product_line.product_uom_qty*1"/> 
                                    <span t-field="product_line.product_uom"/>
                                </td></tr></tbody></table><p t-field="doc.note"/><t t-if="doc.qr_code_position == 'bottom'"><div name="atcud_qr_code" style="page-break-inside: avoid;"><p t-if="doc.inalterable_hash and doc.company_id.qr_code_pt" class="mb-0 mt-0 small">ATCUD:
                                <t t-out="doc.atcud or '0'"/>
                            </p><div id="qrcode_pt" t-if="doc.inalterable_hash and doc.company_id.qr_code_pt"><img class="border border-dark rounded" width="150px" height="150px" t-att-src="image_data_uri(doc.build_qr_code())"/></div><p id="certificate_text" t-if="doc.inalterable_hash and doc.company_id.country_id.code == 'PT'"><span t-translation="off" class="text-nowrap" t-out="''.join([doc.inalterable_hash[i] for i in range(0,40,10)])"/>- Processed by
                                certified
                                software no. 2790/AT
                            </p></div></t></div></t></t></template><record id="action_print_transport_document" model="ir.actions.report"><field name="name">Transport Document</field><field name="model">pt.transport</field><field name="report_type">qweb-pdf</field><field name="report_file">l10n_pt_stock.report_transport</field><field name="report_name">l10n_pt_stock.report_transport</field><field name="print_report_name">(object._get_report_base_filename())</field><field name="binding_model_id" ref="model_pt_transport"/><field name="binding_type">report</field><field name="protected" eval="True"/></record></odoo>
