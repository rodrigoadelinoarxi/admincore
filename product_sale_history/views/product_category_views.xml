<odoo>
    <record id="product_category_form_view_inherit_prod_hist" model="ir.ui.view">
        <field name="model">product.category.form.view.inherit.prod.hist</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="stock.product_category_form_view_inherit"/>
        <field type="xml" name="arch">
            <xpath expr="//field[@name='removal_strategy_id']" position="after">
                <label for="buy_limit_category" string="Buying Limit for Category"/>
                <div class="o_row">
                    <field name="buy_limit_category"/>
                    <span>
                        <field name="buy_limit_quant" invisible="not buy_limit_category"/>
                    </span>
                </div>
                <field name="buy_limit_product" invisible="not buy_limit_category"/>
            </xpath>
        </field>
    </record>

    <!-- auto-fix: account_taxcloud descontinuado no Odoo 19 (modulo Enterprise
         ja nao existe nesta versao) - vista que dependia dele removida, os
         campos auto_validate_and_email/email_template_id continuam a existir
         no modelo, so deixam de ser editaveis a partir desta vista -->
</odoo>
