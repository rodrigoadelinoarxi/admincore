<odoo>
    <record id="sale_product_history_form_view" model="ir.ui.view">
        <field name="model">sale.product.history.form.view</field>
        <field name="model">sale.product.history</field>
        <field type="xml" name="arch">
           <tree>
                <field name="partner_id" readonly="1" force_save="1"/>
                <field name="sale_id" readonly="1" force_save="1"/>
                <field name="product_id" readonly="1" force_save="1"/>
                <field name="product_quant" readonly="1" force_save="1"/>
            </tree>
        </field>
    </record>

    <record id="sale_product_history_form_view_action" model="ir.actions.act_window">
        <field name="name">Validity Status</field>
        <field name="res_model">sale.product.history</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="sale_product_history_form_view"/>
    </record>

    <menuitem id="menu_sale_product_history"
        action="sale_product_history_form_view_action"
        name="Product Sale History"
        parent="sale.prod_config_main"
        sequence="25"/>
</odoo>
