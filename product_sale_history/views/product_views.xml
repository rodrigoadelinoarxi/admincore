<odoo>
    <record id="product_template_form_inherit_prod_hist" model="ir.ui.view">
        <field name="model">product.template.form.inherit.prod.hist</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field type="xml" name="arch">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="categ_product_limit" invisible="1"/>
                <field name="buy_limit_quant" invisible="not categ_product_limit"/>
            </xpath>
        </field>
    </record>
</odoo>
