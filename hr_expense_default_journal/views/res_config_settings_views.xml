<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.hr_expense_default_journal</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_expense.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@data-key=('hr_expense')]" position="inside">
                <h2>Accounting</h2>
                <div class="row mt16 o_settings_container">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">Default Expense Journal</span>
                            <span class="fa fa-lg fa-building-o" title="Values set here are company-specific."
                                  aria-label="Values set here are company-specific."
                                  groups="base.group_multi_company" role="img"/>
                            <div class="text-muted">
                                Default expense journal of your company
                            </div>
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="expense_default_journal_id" string="Journal"
                                           class="col-lg-3 o_light_label"/>
                                    <field name="expense_default_journal_id"
                                           options="{'no_create_edit': True, 'no_open': True}"
                                           context="{'active_test': False}"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
