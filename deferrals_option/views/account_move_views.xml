<odoo>
    <record id="view_move_form_asset_deferral_inherit" model="ir.ui.view">
        <field name="name">account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <field name="deferral_exists" invisible="1"/>
            </xpath>

            <xpath expr="//button[@name='action_open_asset_ids'][1]" position="attributes">
                <attribute name="invisible">count_asset == 0 or draft_asset_exists or deferral_exists</attribute>
            </xpath>
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_open_asset_ids"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-id-card-o"
                        invisible="count_asset == 0 or draft_asset_exists or not deferral_exists">
                    <field string="Deferral(s)" name="count_asset" widget="statinfo"/>
                </button>
            </xpath>

            <xpath expr="//button[@name='action_open_asset_ids'][2]" position="attributes">
                <attribute name="invisible">count_asset == 0 or not draft_asset_exists or deferral_exists</attribute>
            </xpath>
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_open_asset_ids"
                        type="object"
                        class="oe_stat_button text-danger"
                        icon="fa-id-card-o"
                        invisible="count_asset == 0 or not draft_asset_exists or not deferral_exists">
                    <field string="Deferral(s)" name="count_asset" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
