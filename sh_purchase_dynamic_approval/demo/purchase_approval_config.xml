<odoo noupdate="1">
    <!--International Pro-Forma-->
    <record id="international_approval" model="sh.purchase.approval.config">
        <field name="name">International Pro-Forma</field>
        <field name="min_amount">100</field>
        <field name="company_ids" eval="[(4, ref('base.main_company'))]"/>
        <field name="sequence">1</field>
        <field name="purchase_approval_line_ids" eval="[(5, 0, 0),
            (0, 0, {
                'level': 1,
                'approve_by': 'user',
                'user_ids': [(5, 0, 0),
                    (4, ref('base.user_admin'))
                ]
            }),
            (0, 0, {
                'level': 2,
                'approve_by': 'group',
                'group_ids': [(5, 0, 0),
                    (4, ref('account.group_account_user'))
                ]
            })
        ]"/>
    </record>
    <!--National Pro-Forma-->
    <record id="national_approval" model="sh.purchase.approval.config">
        <field name="name">National Pro-Forma Min 250</field>
        <field name="min_amount">250</field>
        <field name="company_ids" eval="[(4, ref('base.main_company'))]"/>
        <field name="sequence">2</field>
        <field name="purchase_approval_line_ids" eval="[(5, 0, 0),
            (0, 0, {
                'level': 0,
                'approve_by': 'user',
                'user_ids': [(5, 0, 0),
                    (4, ref('base.user_demo'))
                ]
            }),
            (0, 0, {
                'level': 1,
                'approve_by': 'user',
                'user_ids': [(5, 0, 0),
                    (4, ref('base.user_admin'))
                ]
            })
        ]"/>
    </record>
    <record id="national_approval_one_level" model="sh.purchase.approval.config">
        <field name="name">National Pro-Forma Min 100</field>
        <field name="min_amount">75</field>
        <field name="company_ids" eval="[(4, ref('base.main_company'))]"/>
        <field name="sequence">3</field>
        <field name="purchase_approval_line_ids" eval="[(5, 0, 0),
            (0, 0, {
                'level': 0,
                'approve_by': 'user',
                'user_ids': [(5, 0, 0),
                    (4, ref('base.user_admin'))
                ]
            })
        ]"/>
    </record>
</odoo>